# ===========================================
# Docker Symfony Boilerplate - Variables de Entorno
# ===========================================
# Copia este archivo a .env y ajusta los valores según tu entorno

# Puertos de la aplicación
APP_PORT=1500
MYSQL_PORT=1000
MAILHOG_WEB_PORT=8025
MAILHOG_SMTP_PORT=1025

# MySQL
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=project_database

# Xdebug
# Linux: Obtener IP con: ip a | grep docker0
# MacOS/Windows WSL2: Usar host.docker.internal
XDEBUG_CLIENT_HOST=172.17.0.1
XDEBUG_CLIENT_PORT=9003
